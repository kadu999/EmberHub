# 中转站（OpenList）：只提交脚本，不提交程序与数据
/openlist/

# 压缩包 / 存档
*.zip
*.7z
*.sav

# 示例库中的真实测试资源（ROM / 模拟器 / 素材）不入库，只提交 JSON 结构
/app/examples/sample-library/Roms/*/media/
/app/examples/sample-library/Emulators/**/*.zip
/app/examples/sample-library/Emulators/**/*.7z

# 系统文件
.DS_Store
Thumbs.db

# 本地令牌 / 密钥（百度网盘 token 等）
baidu_token.json

# Python
__pycache__/
*.pyc

# 媒体检测报告
media-report-*.txt
resource-report-*.txt
