# 中转站（OpenList）：只提交脚本，不提交程序与数据
/openlist/

# 本地运行时数据（脚本报告 / 密钥）
/data/

# 导出的发布产物（安装包 / APK）
/release/

# 压缩包 / 存档
*.zip
*.7z
*.sav

# 构建日志（如 Android 构建输出重定向的 error.log）
*.log

# Tauri 移动端 dev 生成的辅助程序
/updater-server.exe

# 系统文件
.DS_Store
Thumbs.db

# 脚本本地配置（含账号，复制 config.example.json 后使用）
/scripts/media/config.json

# Python
__pycache__/
*.pyc
