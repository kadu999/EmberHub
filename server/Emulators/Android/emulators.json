{
  "platforms": {
    "GBA": "RetroArch",
    "GBA hack": "RetroArch",
    "GBA vib": "RetroArch",
    "NDS": "RetroArch",
    "PS1": "RetroArch",
    "PS2": "AetherSX2",
    "DC": "RetroArch",
    "SS": "RetroArch"
  },
  "emulators": {
    "RetroArch": {
      "platform": "RetroArch",
      "exe": "com.retroarch",
      "package": "com.retroarch",
      "apk": "RetroArch.apk",
      "activity": "com.retroarch/.browser.retroactivity.RetroActivityFuture",
      "extras": {
        "ROM": "{file.path}"
      },
      "platformExtras": {
        "GBA": { "LIBRETRO": "mgba_libretro_android" },
        "GBA hack": { "LIBRETRO": "mgba_libretro_android" },
        "GBA vib": { "LIBRETRO": "mgba_libretro_android" },
        "NDS": { "LIBRETRO": "melondsds_libretro_android" },
        "PS1": { "LIBRETRO": "swanstation_libretro_android" },
        "DC": { "LIBRETRO": "flycast_libretro_android" },
        "SS": { "LIBRETRO": "yabasanshiro_libretro_android" }
      }
    },
    "AetherSX2": {
      "platform": "AetherSX2",
      "exe": "xyz.aethersx2.android",
      "package": "xyz.aethersx2.android",
      "mime": "application/octet-stream"
    },
    "PPSSPP": {
      "platform": "PPSSPP",
      "exe": "org.ppsspp.ppsspp",
      "package": "org.ppsspp.ppsspp",
      "apk": "PPSSPP.apk"
    },
    "melonDS": {
      "platform": "melonDS",
      "exe": "me.magnum.melonds",
      "package": "me.magnum.melonds",
      "apk": "melonDS.apk"
    }
  }
}
