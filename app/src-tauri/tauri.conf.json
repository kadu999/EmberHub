{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EmberHub",
  "version": "0.1.0",
  "identifier": "com.kadu.emberhub",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5185",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EmberHub",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "**",
            "/**",
            "$HOME/**",
            "$APPLOCALDATA/**",
            "$APPDATA/**",
            "$APPCACHE/**"
          ],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
